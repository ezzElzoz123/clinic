<odoo>
    <!-- Wizard Form View -->
    <record id="view_advance_payment_wizard_form" model="ir.ui.view">
        <field name="name">advance.payment.wizard.form</field>
        <field name="model">advance.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Advance Payment">
                <group>
                    <field name="medical_visit_id" readonly="1"/>
                    <field name="amount"/>
                    <field name="currency_id" readonly="1"/>
                    <field name="journal_id"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_advance_payment_wizard" model="ir.actions.act_window">
        <field name="name">Advance Payment</field>
        <field name="res_model">advance.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
