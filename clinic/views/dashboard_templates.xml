<odoo>
    <template id="ClinicDashboard">
        <div class="dashboard">
            <div class="dashboard-card normal">
                <h3>Patients</h3>
                <span t-esc="patients_count"/>
            </div>
            <div class="dashboard-card high-risk">
                <h3>High Risk Patients</h3>
                <span t-esc="high_risk_count"/>
            </div>
            <div class="dashboard-card follow-up">
                <h3>Follow-Ups</h3>
                <span t-esc="follow_up_count"/>
            </div>
            <div class="dashboard-card normal">
                <h3>Revenue</h3>
                <span t-esc="revenue"/>
            </div>
        </div>
    </template>
</odoo>