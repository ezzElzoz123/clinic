<odoo>
    <record id="res_config_settings_view_form_medical" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.medical</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" string="Medical Settings">
                    <h2>Medical Visit Settings</h2>
                    <group>
                        <field name="checkup_price"/>
                        <field name="consultation_price"/>
                    </group>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
