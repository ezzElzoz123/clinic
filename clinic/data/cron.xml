<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action -->
        <record id="action_expire_cron" model="ir.cron">
            <field name="name">Expire Insurance Company Contract</field>
            <field name="model_id" ref="model_insurance_company"/>
            <field name="state">code</field>
            <field name="code">
                model.action_expire()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
        <record id="action_notify_cron" model="ir.cron">
            <field name="name">Notify Before Next Visit</field>
            <field name="model_id" ref="model_medical_visit"/>
            <field name="state">code</field>
            <field name="code">
                model.action_notify_before_num_of_days()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>